{% doc %}
  One FAQ question and answer as a native <details> disclosure (keyboard and screen-reader
  friendly with no JS).
{% enddoc %}
<details class="faq-item" {{ block.shopify_attributes }}>
  <summary>{{ block.settings.question | escape }}</summary>
  <div class="faq-item__answer">{{ block.settings.answer }}</div>
</details>

{% stylesheet %}
  .faq-item {
    border-bottom: 1px solid var(--color-line);
  }
  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding-block: var(--space-3);
    font-size: var(--text-lg);
    list-style: none;
    cursor: pointer;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary::after {
    content: '+';
    flex-shrink: 0;
    font-size: var(--text-xl);
    line-height: 1;
  }
  .faq-item[open] summary::after {
    content: '−';
  }
  .faq-item__answer {
    max-width: 44rem;
    padding-bottom: var(--space-5);
    color: var(--color-foreground-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:blocks.faq_item.name",
  "settings": [
    { "type": "text", "id": "question", "label": "t:labels.question", "default": "Are your products suitable for sensitive skin?" },
    {
      "type": "richtext",
      "id": "answer",
      "label": "t:labels.answer",
      "default": "<p>Every formula is fragrance-free and dermatologist-tested. Patch-test new products first.</p>"
    }
  ],
  "presets": [{ "name": "t:blocks.faq_item.name" }]
}
{% endschema %}
