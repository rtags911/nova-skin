{% doc %}
  Line icons for the benefit block. Stroke uses currentColor so they follow the scheme.

  @param {string} icon - leaf | drop | shield | recycle | heart
{% enddoc %}
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" focusable="false">
  {% case icon %}
    {% when 'drop' %}
      <path d="M12 3.5c3 3.6 5.5 6.9 5.5 10a5.5 5.5 0 0 1-11 0c0-3.1 2.5-6.4 5.5-10Z"/>
    {% when 'shield' %}
      <path d="M12 3 5 6v5.5c0 4.2 2.9 7.6 7 9.5 4.1-1.9 7-5.3 7-9.5V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>
    {% when 'recycle' %}
      <path d="M7 19h10l-2.5-4M4.5 13.5 7 9l2.5 4M14.5 5l2.5 4.5H12"/><path d="M12 9.5 9.5 5h5"/>
    {% when 'heart' %}
      <path d="M12 19.5s-7-4.3-7-9.2A4 4 0 0 1 12 8a4 4 0 0 1 7 2.3c0 4.9-7 9.2-7 9.2Z"/>
    {% else %}
      <path d="M5 19c0-8 5-13 14-14-1 9-6 14-14 14Z"/><path d="M5 19 13 11"/>
  {% endcase %}
</svg>
