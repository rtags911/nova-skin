{% comment %}
  /cart page. The no-JS cart, and the page checkout links fall back to.
  Shares its contents with the drawer through the cart-items snippet.
{% endcomment %}
<div class="cart-page full-width">
  <h1 class="h2">{{ 'cart.title' | t }}</h1>
  {% render 'cart-items', section_id: section.id %}
</div>

{% stylesheet %}
  .cart-page {
    max-width: 48rem;
    margin-inline: auto;
    padding: var(--space-9) var(--page-margin) var(--space-10);
  }
  .cart-page h1 {
    margin-bottom: var(--space-6);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart",
  "class": "section-cart",
  "settings": []
}
{% endschema %}
