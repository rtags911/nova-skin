<div class="section benefits full-width color-{{ section.settings.color_scheme }}">
  <div class="section__inner">
    {% render 'section-header', heading: section.settings.heading, text: section.settings.text, center: true %}
    <ul class="benefits__grid" role="list">
      {% content_for 'blocks' %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .benefits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 990px) {
    .benefits__grid {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      text-align: center;
    }
    .benefits__grid .benefit__icon {
      justify-self: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.benefits.name",
  "class": "section-benefits",
  "blocks": [{ "type": "benefit" }],
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Made to be gentle" },
    { "type": "richtext", "id": "text", "label": "t:labels.text" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-2" }
  ],
  "presets": [
    {
      "name": "t:sections.benefits.name",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "leaf", "title": "Clean formulas", "text": "No parabens, sulfates or added fragrance." } },
        { "type": "benefit", "settings": { "icon": "shield", "title": "Patch-tested", "text": "Every formula is tested on sensitive skin." } },
        { "type": "benefit", "settings": { "icon": "heart", "title": "Cruelty-free", "text": "Never tested on animals." } },
        { "type": "benefit", "settings": { "icon": "recycle", "title": "Recyclable glass", "text": "Bottles and jars you can recycle." } }
      ]
    }
  ]
}
{% endschema %}
