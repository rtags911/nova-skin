<div class="section promo-banner full-width color-{{ section.settings.color_scheme }}">
  <div class="section__inner">
    <div class="promo-banner__box{% if section.settings.image != blank %} promo-banner__box--image{% endif %}">
      {% if section.settings.image != blank %}
        <div class="promo-banner__media">
          {{
            section.settings.image
            | image_url: width: 1600
            | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy'
          }}
        </div>
      {% endif %}
      <div class="promo-banner__content">
        {% if section.settings.eyebrow != blank %}<p class="label">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{% endif %}
        {% if section.settings.text != blank %}<div>{{ section.settings.text }}</div>{% endif %}
        {% if section.settings.button_label != blank %}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .promo-banner__box {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-line);
  }
  .promo-banner__media {
    aspect-ratio: 16 / 10;
  }
  .promo-banner__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .promo-banner__content {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-6);
  }
  @media (min-width: 990px) {
    .promo-banner__box--image {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .promo-banner__media {
      aspect-ratio: auto;
      min-height: 26rem;
    }
    .promo-banner__content {
      padding: var(--space-10);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.promo_banner.name",
  "class": "section-promo-banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Starter set" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "The Daily Ritual Set" },
    {
      "type": "richtext", "id": "text", "label": "t:labels.text",
      "default": "<p>Cleanser, serum and moisturiser in travel sizes. A full routine to start with.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Shop the set" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "t:sections.promo_banner.name" }]
}
{% endschema %}
