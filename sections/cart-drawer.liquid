{% comment %}
  Cart drawer: a native <dialog> opened with showModal(), which gives focus trapping,
  Escape to close and an inert page behind it without extra JS. Rendered statically from
  layout/theme.liquid, so its section id is "cart-drawer". Without JS the header cart
  link simply goes to /cart.
{% endcomment %}
<cart-drawer>
  <dialog class="cart-drawer color-{{ section.settings.color_scheme }}" id="CartDrawer" aria-labelledby="CartDrawerTitle" scroll-lock>
    <div class="cart-drawer__inner">
      <header class="cart-drawer__header">
        <h2 class="h4" id="CartDrawerTitle">
          {{ 'cart.title' | t }} <span class="text-muted" data-cart-count>({{ cart.item_count }})</span>
        </h2>
        <form method="dialog">
          <button class="cart-drawer__close" type="submit" aria-label="{{ 'cart.close' | t }}">
            {{ 'icon-close.svg' | inline_asset_content }}
          </button>
        </form>
      </header>
      {% render 'cart-items', section_id: section.id %}
    </div>
  </dialog>
</cart-drawer>

{% stylesheet %}
  .cart-drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(28rem, 100%);
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    transform: translateX(100%);
    transition:
      transform var(--duration-base) var(--ease-out),
      overlay var(--duration-base) allow-discrete,
      display var(--duration-base) allow-discrete;
  }
  .cart-drawer[open] {
    transform: translateX(0);
  }
  @starting-style {
    .cart-drawer[open] {
      transform: translateX(100%);
    }
  }
  .cart-drawer::backdrop {
    background: color-mix(in srgb, var(--color-foreground) 40%, transparent);
  }
  .cart-drawer__inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-4) var(--space-5) var(--space-5);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-4);
  }
  .cart-drawer__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-right: calc(var(--space-3) * -1);
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .cart-drawer__close svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .cart-drawer .cart-items {
    flex: 1;
  }
  /* Keep subtotal + checkout in view while the list scrolls */
  .cart-drawer .cart-items__footer {
    position: sticky;
    bottom: calc(var(--space-5) * -1);
    margin-inline: calc(var(--space-5) * -1);
    padding: var(--space-5);
    background: var(--color-background);
  }
{% endstylesheet %}

{% javascript %}
  class CartDrawer extends HTMLElement {
    connectedCallback() {
      this.dialog = this.querySelector('dialog');
      // Header is re-rendered after cart changes, so listen on the document
      document.addEventListener('click', (event) => {
        const link = event.target.closest('#HeaderCart');
        if (!link) return;
        event.preventDefault();
        this.opener = link;
        this.open();
      });
      document.addEventListener('cart:added', () => this.refresh().then(() => this.open()));
      // A click on the dimmed backdrop lands on the <dialog> itself
      this.dialog.addEventListener('click', (event) => {
        if (event.target === this.dialog) this.dialog.close();
      });
      this.dialog.addEventListener('close', () => {
        (this.opener?.isConnected ? this.opener : document.getElementById('HeaderCart'))?.focus();
      });
    }

    open() {
      if (!this.dialog.open) this.dialog.showModal();
    }

    async refresh() {
      const id = this.querySelector('cart-items')?.dataset.section || 'cart-drawer';
      try {
        const response = await fetch(`${window.Shopify.routes.root}?sections=${id}`);
        customElements.get('cart-items').renderSections(await response.json());
      } catch {
        // Opening the stale drawer is better than not opening it
      }
    }
  }
  customElements.define('cart-drawer', CartDrawer);
{% endjavascript %}

{% schema %}
{
  "name": "t:general.cart",
  "class": "section-cart-drawer",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
