<div class="section featured-collections full-width color-{{ section.settings.color_scheme }}">
  <div class="section__inner">
    {% render 'section-header', heading: section.settings.heading, text: section.settings.text %}
    <ul class="featured-collections__grid" role="list">
      {% content_for 'blocks' %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .featured-collections__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 990px) {
    .featured-collections__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-5);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collections.name",
  "class": "section-featured-collections",
  "blocks": [{ "type": "collection-card" }],
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Shop by concern" },
    { "type": "richtext", "id": "text", "label": "t:labels.text", "default": "<p>Start with what your skin needs.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collections.name",
      "blocks": [
        { "type": "collection-card" },
        { "type": "collection-card" },
        { "type": "collection-card" },
        { "type": "collection-card" }
      ]
    }
  ]
}
{% endschema %}
