{% liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
%}
<div class="featured-products color-{{ section.settings.color_scheme }} full-width">
  <div class="featured-products__inner">
    <div class="featured-products__header">
      {% if section.settings.heading != blank %}
        <h2 class="h3">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if collection != blank and section.settings.show_view_all %}
        <a class="featured-products__all" href="{{ collection.url }}">{{ 'sections.featured_products.view_all' | t }}</a>
      {% endif %}
    </div>

    <ul class="product-grid product-grid--{{ section.settings.columns_desktop }}" role="list">
      {% if collection != blank and collection.products_count > 0 %}
        {% for product in collection.products limit: limit %}
          <li>{% render 'product-card', product: product %}</li>
        {% endfor %}
      {% else %}
        {% # Theme editor preview before a collection is picked %}
        {% for i in (1..limit) %}
          <li class="product-card">
            <div class="product-card__media">{{ 'product-1' | placeholder_svg_tag: 'product-card__image product-card__placeholder' }}</div>
            <p class="product-card__title">{{ 'sections.featured_products.placeholder_title' | t }}</p>
          </li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .featured-products {
    padding-block: var(--space-10);
  }
  .featured-products__inner {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .featured-products__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-7);
  }
  .featured-products__all {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_products.name",
  "class": "section-featured-products",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Bestsellers" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    {
      "type": "range", "id": "products_to_show", "label": "t:labels.products_to_show",
      "min": 2, "max": 12, "step": 1, "default": 4
    },
    {
      "type": "select", "id": "columns_desktop", "label": "t:labels.columns_desktop", "default": "4",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    { "type": "checkbox", "id": "show_view_all", "label": "t:labels.show_view_all", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:sections.featured_products.name" }]
}
{% endschema %}
