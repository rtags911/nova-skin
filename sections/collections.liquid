{% comment %}
  All collections (/collections). Square tiles matching the homepage "Shop by concern" tiles.
{% endcomment %}
<div class="page-shell full-width">
  <h1 class="h2 page-shell__title">{{ 'collections.title' | t }}</h1>
  <ul class="collections-list" role="list">
    {% for collection in collections %}
      <li>
        <a class="collections-list__link" href="{{ collection.url }}">
          <span class="collections-list__media">
            {% if collection.featured_image %}
              {{
                collection.featured_image
                | image_url: width: 900
                | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: ''
              }}
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'collections-list__placeholder' }}
            {% endif %}
          </span>
          <span class="collections-list__title">{{ collection.title | escape }}</span>
          <span class="text-muted">{{ 'collections.product_count' | t: count: collection.products_count }}</span>
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

{% stylesheet %}
  .collections-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-7) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 990px) {
    .collections-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-8) var(--space-5);
    }
  }
  .collections-list__link {
    display: grid;
    gap: var(--space-1);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .collections-list__media {
    display: block;
    aspect-ratio: 1;
    margin-bottom: var(--space-2);
    overflow: hidden;
    background: var(--color-line);
  }
  .collections-list__media img,
  .collections-list__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .collections-list__placeholder {
    fill: var(--color-foreground-muted);
    opacity: 0.35;
  }
  .collections-list__title {
    font-family: var(--font-heading--family);
    font-size: var(--text-xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "class": "section-collections",
  "settings": []
}
{% endschema %}
