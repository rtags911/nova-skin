<div class="section image-with-text image-with-text--{{ section.settings.image_position }} full-width color-{{ section.settings.color_scheme }}">
  <div class="section__inner image-with-text__inner">
    <div class="image-with-text__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 1600
          | image_tag:
            widths: '450, 750, 1000, 1300, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy'
        }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'image-with-text__placeholder' }}
      {% endif %}
    </div>
    <div class="image-with-text__content">
      {% if section.settings.eyebrow != blank %}<p class="label">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.text != blank %}<div class="image-with-text__text">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button button--secondary" href="{{ section.settings.button_link | default: routes.root_url }}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text__inner {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  .image-with-text__media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-line);
  }
  .image-with-text__media img,
  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .image-with-text__placeholder {
    fill: var(--color-foreground-muted);
    opacity: 0.35;
  }
  .image-with-text__content {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 32rem;
  }
  .image-with-text__text {
    font-size: var(--text-lg);
  }
  @media (min-width: 990px) {
    .image-with-text__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-11);
    }
    .image-with-text--right .image-with-text__media {
      order: 2;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.image_with_text.name",
  "class": "section-image-with-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    {
      "type": "select", "id": "image_position", "label": "t:labels.image_position", "default": "left",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "right", "label": "t:options.alignment.right" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Fewer, better ingredients" },
    {
      "type": "richtext", "id": "text", "label": "t:labels.text",
      "default": "<p>Nova Skin started with a simple idea: a short routine of formulas that do one thing well. We test every batch and list every ingredient.</p>"
    },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label", "default": "Read our story" },
    { "type": "url", "id": "button_link", "label": "t:labels.button_link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:sections.image_with_text.name" }]
}
{% endschema %}
