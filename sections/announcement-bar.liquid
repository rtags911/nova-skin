{% if section.settings.text != blank %}
  <div class="announcement color-{{ section.settings.color_scheme }} full-width" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    <p class="announcement__text label">
      {% if section.settings.link != blank %}
        <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
      {% else %}
        {{ section.settings.text }}
      {% endif %}
    </p>
  </div>
{% endif %}

{% stylesheet %}
  .announcement {
    padding: var(--space-2) var(--page-margin);
    text-align: center;
  }
  .announcement a {
    text-decoration: none;
  }
  .announcement a:hover {
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.announcement.name",
  "class": "section-announcement",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:labels.text",
      "default": "Free shipping on orders over $60"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:labels.link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:labels.color_scheme",
      "default": "scheme-3"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "presets": [
    {
      "name": "t:sections.announcement.name"
    }
  ]
}
{% endschema %}
