{% comment %}
  Search results. Products use the shared product card; pages and articles get a simple text result.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}
<div class="page-shell full-width">
  <h1 class="h2 page-shell__title">{{ 'search.title' | t }}</h1>

  <form class="search-page__form" action="{{ routes.search_url }}" method="get" role="search">
    <label class="visually-hidden" for="SearchPage">{{ 'search.title' | t }}</label>
    <input id="SearchPage" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}">
    <button class="button" type="submit">{{ 'search.submit' | t }}</button>
  </form>

  {% if search.performed %}
    {% paginate search.results by 12 %}
      <p class="search-page__summary text-muted" role="status">
        {% if search.results_count == 0 %}
          {{ 'search.no_results_html' | t: terms: search.terms }}
        {% else %}
          {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
        {% endif %}
      </p>

      {% if search.results_count > 0 %}
        <ul class="product-grid product-grid--4" role="list">
          {% for result in search.results %}
            <li>
              {% if result.object_type == 'product' %}
                {% render 'product-card', product: result %}
              {% else %}
                <a class="search-page__result" href="{{ result.url }}">
                  <span class="label text-muted">{{ result.object_type | capitalize }}</span>
                  <span class="search-page__result-title">{{ result.title | escape }}</span>
                  <span class="text-muted">{{ result.content | strip_html | truncatewords: 18 }}</span>
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
      {% endif %}

      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  {% endif %}
</div>

{% stylesheet %}
  .search-page__form {
    display: flex;
    gap: var(--space-2);
    max-width: 36rem;
  }
  .search-page__form input {
    flex: 1;
    min-width: 0;
  }
  .search-page__summary {
    margin: var(--space-5) 0 var(--space-7);
  }
  .search-page__result {
    display: grid;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    text-decoration: none;
  }
  .search-page__result-title {
    font-family: var(--font-heading--family);
    font-size: var(--text-xl);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "class": "section-search",
  "settings": []
}
{% endschema %}
