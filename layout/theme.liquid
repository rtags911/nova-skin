<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Charset, viewport, title, description, social tags %}
    {% render 'meta-tags' %}

    {% # Fonts, colour schemes and layout settings as CSS variables %}
    {% render 'css-variables' %}

    {% # Design tokens, base styles, buttons: loaded on every page %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {{ content_for_header }}
  </head>

  <body class="color-scheme-1">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
