<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Lets CSS hide no-JS fallbacks (e.g. filter "Apply" button) before first paint %}
    <script>document.documentElement.classList.add('js');</script>
    {% # Translated strings for scripts (no copy hard-coded in JS) %}
    <script>
      window.theme = {
        strings: {
          addToCart: {{ 'products.add_to_cart' | t | json }},
          cartError: {{ 'cart.error' | t | json }},
          cartUpdated: {{ 'cart.updated' | t | json }},
          added: {{ 'products.added' | t | json }},
          error: {{ 'products.error' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }}
        }
      };
    </script>

    {% # Charset, viewport, title, description, social tags %}
    {% render 'meta-tags' %}

    {% # Fonts, colour schemes and layout settings as CSS variables %}
    {% render 'css-variables' %}

    {% # Design tokens, base styles, buttons: loaded on every page %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {{ content_for_header }}
  </head>

  <body class="color-scheme-1">
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% section 'cart-drawer' %}
  </body>
</html>
