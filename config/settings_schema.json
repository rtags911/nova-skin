[
  {
    "name": "theme_info",
    "theme_name": "Nova Skin",
    "theme_version": "0.1.0",
    "theme_author": "rtags911",
    "theme_documentation_url": "https://github.com/rtags911/nova-skin",
    "theme_support_url": "https://github.com/rtags911/nova-skin/issues"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "cormorant_n5",
        "label": "t:labels.heading_font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "t:labels.body_font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          { "value": "90rem", "label": "t:options.page_width.narrow" },
          { "value": "110rem", "label": "t:options.page_width.wide" }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 2,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 16
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "t:labels.background", "default": "#F7F4EF" },
          { "type": "color_background", "id": "background_gradient", "label": "t:labels.background_gradient" },
          { "type": "color", "id": "text", "label": "t:labels.text", "default": "#1F1C1A" },
          { "type": "color", "id": "text_muted", "label": "t:labels.text_muted", "default": "#6B635C" },
          { "type": "color", "id": "accent", "label": "t:labels.accent", "default": "#8A5A3F" },
          { "type": "color", "id": "line", "label": "t:labels.line", "default": "#D9D0C3" },
          { "type": "color", "id": "button", "label": "t:labels.button", "default": "#1F1C1A" },
          { "type": "color", "id": "button_label", "label": "t:labels.button_label", "default": "#F7F4EF" }
        ],
        "role": {
          "text": "text",
          "background": { "solid": "background", "gradient": "background_gradient" },
          "links": "accent",
          "icons": "text",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "on_secondary_button": "text",
          "secondary_button_border": "text"
        }
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 2
      }
    ]
  },
  {
    "name": "t:general.social",
    "settings": [
      { "type": "url", "id": "social_instagram_link", "label": "t:labels.social_instagram" },
      { "type": "url", "id": "social_tiktok_link", "label": "t:labels.social_tiktok" },
      { "type": "url", "id": "social_facebook_link", "label": "t:labels.social_facebook" },
      { "type": "url", "id": "social_pinterest_link", "label": "t:labels.social_pinterest" },
      { "type": "url", "id": "social_youtube_link", "label": "t:labels.social_youtube" }
    ]
  }
]
